# =============================================================================
# Configuration « Suivi MAJ GTrans2 » — copier ce fichier en `.env` et compléter
# =============================================================================

# --- Mode d'authentification -------------------------------------------------
# entra    : SSO Microsoft Entra ID (production)
# disabled : aucune authentification — aperçu / test en local UNIQUEMENT
AUTH_MODE=disabled
# AUTH_MODE= entra

# --- URL publique de l'outil -------------------------------------------------
# Doit correspondre exactement à l'URL par laquelle les utilisateurs y accèdent.
# Sert à construire l'URI de redirection : <PUBLIC_URL>/auth/callback
PUBLIC_URL=https://maj-gt2.sifalogistics.com

# --- Inscription d'application Entra ID --------------------------------------
# Fournis par l'administrateur Microsoft 365 (voir README, section « SSO »).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=changez-moi

# --- Secret de signature des sessions ----------------------------------------
# Générer avec :  openssl rand -base64 48
SESSION_SECRET=changez-moi-par-une-chaine-aleatoire-de-48-octets

# --- Restriction d'accès (optionnel) -----------------------------------------
# Liste blanche d'adresses e-mail, séparées par des virgules.
# Si vide, tout compte du tenant Entra ID est accepté.
ALLOWED_EMAILS=bmarzougui@sifalogistics.com

# --- Réglages avancés (optionnel) --------------------------------------------
# Durée de validité d'une session
SESSION_TTL=12h
# Délai de regroupement des écritures sur disque, en millisecondes
SAVE_DEBOUNCE_MS=500
